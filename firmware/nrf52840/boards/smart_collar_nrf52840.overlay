/*
 * Smart Collar nRF52840 – Device Tree Overlay
 *
 * Pin assignments (example mapping – adjust to actual PCB schematic):
 *
 *   QSPI (W25Q128 16 MB NOR flash)
 *     SCK  : P0.19
 *     IO0  : P0.20  (MOSI / SIO0)
 *     IO1  : P0.21  (MISO / SIO1)
 *     IO2  : P0.22  (WP   / SIO2)
 *     IO3  : P0.23  (HOLD / SIO3)
 *     CS   : P0.17
 *
 *   UART0 – bridge to nRF9160 (1 Mbps)
 *     TX   : P0.06
 *     RX   : P0.08
 *     RTS  : P0.07  (flow control)
 *     CTS  : P0.05  (flow control)
 *
 *   Charge detection
 *     CHG_DET   : P1.02  (magnetic connector, active-low)
 *     CHG_STAT  : P1.03  (nPM1100 CHG_STAT, active-low)
 *
 *   LED (shared with nRF9160 via GPIO; only white LED on 52840 side)
 *     LED_WHITE : P0.28
 */

/ {
	chosen {
		zephyr,flash-controller = &qspi;
	};

	/* Charge / connector GPIOs exposed as a GPIO-keys node */
	charge_gpios {
		compatible = "gpio-keys";
		chg_detect: chg_detect {
			label = "Charge Connector Detect";
			gpios = <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
		chg_stat: chg_stat {
			label = "Charge Status";
			gpios = <&gpio1 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
	};

	/* White LED */
	leds {
		compatible = "gpio-leds";
		led_white: led_white {
			label = "White LED";
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
		};
	};

	aliases {
		led0         = &led_white;
		chg-detect   = &chg_detect;
		chg-stat     = &chg_stat;
		uart-bridge  = &uart0;
		ext-flash    = &w25q128;
	};
};

/* ---------------------------------------------------------------
 * QSPI – W25Q128 (16 MB NOR flash)
 * ------------------------------------------------------------- */
&qspi {
	status = "okay";
	pinctrl-0 = <&qspi_default>;
	pinctrl-1 = <&qspi_sleep>;
	pinctrl-names = "default", "sleep";

	w25q128: w25q128jv@0 {
		compatible = "nordic,qspi-nor";
		reg = <0>;
		writeoc = "pp4io";
		readoc  = "read4io";
		sck-frequency = <8000000>;
		jedec-id = [ef 40 18];
		size = <DT_SIZE_M(128)>;
		has-dpd;
		t-enter-dpd = <3000>;
		t-exit-dpd  = <3000>;
		sfdp-bfp    = [e5 20 f1 ff  ff ff ff 03
		               44 eb 08 6b  08 3b 04 bb
		               ee ff ff ff  ff ff 00 ff
		               ff ff 00 ff  0c 20 0f 52
		               10 d8 00 ff];
	};
};

/* Pin control for QSPI */
&pinctrl {
	qspi_default: qspi_default {
		group1 {
			psels = <NRF_PSEL(QSPI_SCK,  0, 19)>,
			        <NRF_PSEL(QSPI_IO0,  0, 20)>,
			        <NRF_PSEL(QSPI_IO1,  0, 21)>,
			        <NRF_PSEL(QSPI_IO2,  0, 22)>,
			        <NRF_PSEL(QSPI_IO3,  0, 23)>,
			        <NRF_PSEL(QSPI_CSN,  0, 17)>;
		};
	};
	qspi_sleep: qspi_sleep {
		group1 {
			psels = <NRF_PSEL(QSPI_SCK,  0, 19)>,
			        <NRF_PSEL(QSPI_IO0,  0, 20)>,
			        <NRF_PSEL(QSPI_IO1,  0, 21)>,
			        <NRF_PSEL(QSPI_IO2,  0, 22)>,
			        <NRF_PSEL(QSPI_IO3,  0, 23)>,
			        <NRF_PSEL(QSPI_CSN,  0, 17)>;
			low-power-enable;
		};
	};

	/* UART0 to nRF9160 */
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX,  0, 6)>,
			        <NRF_PSEL(UART_RTS, 0, 7)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX,  0, 8)>,
			        <NRF_PSEL(UART_CTS, 0, 5)>;
			bias-pull-up;
		};
	};
	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX,  0, 6)>,
			        <NRF_PSEL(UART_RX,  0, 8)>,
			        <NRF_PSEL(UART_RTS, 0, 7)>,
			        <NRF_PSEL(UART_CTS, 0, 5)>;
			low-power-enable;
		};
	};
};

/* UART0 – inter-chip bridge */
&uart0 {
	status = "okay";
	compatible = "nordic,nrf-uarte";
	current-speed = <1000000>;
	hw-flow-control;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

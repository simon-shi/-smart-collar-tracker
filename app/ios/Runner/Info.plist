<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Smart Collar</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>smart_collar_tracker</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Bluetooth Permissions -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Smart Pet Collar needs Bluetooth to connect to your pet's collar for real-time tracking and data sync.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Smart Pet Collar needs Bluetooth to connect to your pet's collar.</string>

	<!-- Location Permissions -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Smart Pet Collar needs your location to show you the distance and direction to your pet on the map.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Smart Pet Collar needs background location access for continuous pet tracking and geofence alerts.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Smart Pet Collar needs your location to display your position alongside your pet's location on the map.</string>

	<!-- Camera Permission -->
	<key>NSCameraUsageDescription</key>
	<string>Smart Pet Collar needs camera access to take your pet's profile photo.</string>

	<!-- Photo Library Permission -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Smart Pet Collar needs access to your photo library to set your pet's profile photo.</string>

	<!-- Motion Permission (for activity detection) -->
	<key>NSMotionUsageDescription</key>
	<string>Smart Pet Collar uses motion data to improve activity tracking accuracy.</string>

	<!-- Background Modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>location</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- Face ID -->
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to securely and quickly sign in to Smart Pet Collar.</string>
</dict>
</plist>
